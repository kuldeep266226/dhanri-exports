<!--
Dhanri International Exports - English Website (Single-file)
File: index.html
Description:
- This is a clean, professional, English-only single-file website template for a merchant exporter.
- Edit text, images, and contact details as needed. Save as index.html and deploy via GitHub Pages or Netlify.

How to use:
1. Save this file as `index.html`.
2. Open in a code editor (VSCode, Notepad++).
3. Edit company details, products and images.
4. Deploy: GitHub Pages or Netlify (free hosting).
-->

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dhanri International Exports — Official Website</title>
  <meta name="description" content="Dhanri International Exports - Merchant Exporter of spices, grains, dried fruits and more." />
  <style>
    :root{--bg:#fff;--text:#0b1220;--accent:#0b7c58;--muted:#55606b}
    *{box-sizing:border-box}
    body{margin:0;font-family:Arial, Helvetica, sans-serif;background:#f7f9fb;color:var(--text);line-height:1.6}
    .container{max-width:1000px;margin:18px auto;padding:18px}
    header{display:flex;align-items:center;justify-content:space-between}
    .brand{display:flex;gap:12px;align-items:center}
    .logo{width:64px;height:64px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#2b9d7a);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}
    h1{margin:6px 0}
    .subtitle{color:var(--muted);margin:0}
    nav{display:flex;gap:12px}
    a{color:var(--accent);text-decoration:none}
    .hero{display:flex;gap:18px;align-items:center;margin-top:18px}
    .hero .left{flex:1}
    .card{background:#fff;padding:16px;border-radius:10px;box-shadow:0 4px 14px rgba(12,18,20,0.06)}
    .muted{color:var(--muted)}
    .products{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:12px}
    .prod{padding:12px;border-radius:8px;background:linear-gradient(180deg,#ffffff,#fbfcfd);border:1px solid #eef2f4}
    footer{margin-top:20px;color:var(--muted);font-size:14px}
    .contact-form input, .contact-form textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #e0e6ea;margin-bottom:8px}
    .btn{background:var(--accent);color:#fff;padding:8px 12px;border-radius:8px;border:none;cursor:pointer}

    @media (max-width:740px){.products{grid-template-columns:1fr}.hero{flex-direction:column}}
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="brand">
        <div class="logo">DI</div>
        <div>
          <h1>Dhanri International Exports</h1>
          <p class="subtitle">Official Website — Merchant Exporter</p>
        </div>
      </div>
      <nav>
        <a href="#about">About</a>
        <a href="#products">Products</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <!-- HERO SECTION -->
    <section class="hero">
      <div class="left">
        <div class="card">
          <h2>Welcome to Dhanri International Exports</h2>
          <p class="muted">We are a merchant exporter specializing in high-quality agricultural and food products for global markets.</p>

          <p style="margin-top:10px">Core product categories: Spices, Herbs & Leaves Seed, Millets & Grains, Dried Fruits & Nuts, Dehydrated Products, Coconut Products, Pulses, and more.</p>
        </div>

        <!-- ABOUT -->
        <div id="about" class="card" style="margin-top:12px">
          <h3>About Us</h3>
          <p class="muted">Dhanri International Exports is a trusted merchant exporter with a network of growers and processors. We ensure rigorous quality control, competitive pricing, and timely shipments.</p>

          <ul>
            <li>Quality assurance and traceability.</li>
            <li>Competitive pricing and bulk supply.</li>
            <li>Flexible packaging and private-label options.</li>
          </ul>
        </div>
      </div>

      <aside style="width:320px">
        <div class="card">
          <h3>Quick Contact</h3>
          <p class="muted">Phone: +91 7014387728</p>
          <p class="muted">Email: kuldeepsinghsonigra.555@gmail.com</p>

          <!-- Contact form is demo-only. To enable real messages, integrate Netlify Forms or Formspree -->
          <div style="margin-top:10px" class="contact-form">
            <input type="text" id="name" placeholder="Your name" />
            <input type="email" id="email" placeholder="Email" />
            <input type="text" id="subject" placeholder="Subject" />
            <textarea id="message" rows="4" placeholder="Message"></textarea>
            <button class="btn" onclick="handleContact()">Send</button>
            <p id="contactStatus" class="muted" style="margin-top:8px"></p>
          </div>
        </div>

        <div class="card" style="margin-top:12px">
          <h4>Tips for editing</h4>
          <ul class="muted">
            <li>Replace the logo text or insert an image inside the .logo element.</li>
            <li>Update contact details in the Quick Contact section.</li>
            <li>Configure Netlify Forms or Formspree for working forms.</li>
          </ul>
        </div>
      </aside>
    </section>

    <!-- PRODUCTS -->
    <section id="products" style="margin-top:18px">
      <h2>Our Products</h2>
      <div class="products">
        <div class="prod">
          <h4>Spices</h4>
          <p>Examples: Red chili, Turmeric, Coriander, Cumin, Black pepper.</p>
        </div>

        <div class="prod">
          <h4>Herbs & Leaves Seed</h4>
          <p>Examples: Mint leaves, Curry leaves, Basil seeds, Fenugreek seeds.</p>
        </div>

        <div class="prod">
          <h4>Millets & Grains</h4>
          <p>Examples: Bajra, Ragi, Pearl Millet, Rice, Wheat.</p>
        </div>

        <div class="prod">
          <h4>Dried Fruits & Nuts</h4>
          <p>Examples: Raisins, Dates, Cashews, Almonds.</p>
        </div>

        <div class="prod">
          <h4>Dehydrated Products</h4>
          <p>Examples: Dehydrated Onion, Garlic, Vegetable powders.</p>
        </div>

        <div class="prod">
          <h4>Coconut Products</h4>
          <p>Examples: Desiccated coconut, Coconut powder, Coconut oil.</p>
        </div>

        <div class="prod">
          <h4>Pulses</h4>
          <p>Examples: Toor dal, Moong dal, Chana dal, Masoor dal.</p>
        </div>

        <div class="prod">
          <h4>Other</h4>
          <p>If you need a product listed here, edit this section to add details.</p>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" style="margin-top:18px">
      <div class="card">
        <h3>Contact Us</h3>
        <p class="muted">Phone: +91 7014387728</p>
        <p class="muted">Email: kuldeepsinghsonigra.555@gmail.com</p>

        <div style="margin-top:12px" class="contact-form">
          <input type="text" id="cname" placeholder="Your name" />
          <input type="email" id="cemail" placeholder="Email" />
          <textarea id="cmsg" rows="4" placeholder="Message"></textarea>
          <button class="btn" onclick="handleContactBottom()">Send Message</button>
          <p id="bottomStatus" class="muted" style="margin-top:8px"></p>
        </div>
      </div>
    </section>

    <footer>
      <div>© <span id="year"></span> Dhanri International Exports</div>
    </footer>
  </div>

  <script>
    // Set current year
    document.getElementById('year').textContent = new Date().getFullYear();

    // Demo contact handlers (no backend)
    function handleContact(){
      const name = document.getElementById('name').value || 'Friend';
      document.getElementById('contactStatus').textContent = 'Thank you, ' + name + '! (Demo form — backend not connected)';
    }
    function handleContactBottom(){
      const name = document.getElementById('cname').value || 'Friend';
      document.getElementById('bottomStatus').textContent = 'Thanks, ' + name + '! (Demo only)';
    }

    /* Deployment tips:
      1. Save file as index.html
      2. GitHub Pages: create a repo and push index.html to root. If repo name is username.github.io the site will be published at https://username.github.io
      3. Netlify Drop: zip this file and drag-drop on Netlify for a free site URL
      4. To enable working contact forms use Netlify Forms or Formspree
    */
  </script>
</body>
</html>
